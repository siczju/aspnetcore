@model LancheListViewModel

<div> <h2>@ViewData["Titulo"]</h2></div>
<div><h3>@Model.CategoriaAtual</h3></div>
<div> <p>@ViewBag.FeitoPorJulio</p></div>
<div> <p>Total de Lanches: @TempData["QtdeLanche"]</p></div>
<br />


<div class="container">
    <div class="row">
        @foreach (var lanche in Model.Lanches)
        {
            <partial name="_LanchesResumo" model="lanche" />
        }
    </div>
</div>